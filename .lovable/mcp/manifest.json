{
  "version": 1,
  "sdk_version": "1.0.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://dwijiddnnwfaisxijhao.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "chronos-v",
      "version": "0.1.0",
      "title": "Chronos-V"
    },
    "tools": [
      {
        "name": "list_appointments",
        "title": "List appointments",
        "description": "List the signed-in user's Chronos-V appointments within an optional time range, ordered by start time.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "description": "ISO timestamp lower bound for start time. Defaults to now.",
              "type": "string"
            },
            "to": {
              "description": "ISO timestamp upper bound for start time.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_appointment",
        "title": "Create appointment",
        "description": "Create a new appointment on the signed-in user's Chronos-V schedule.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Appointment title."
            },
            "starts_at": {
              "type": "string",
              "description": "ISO 8601 start timestamp."
            },
            "ends_at": {
              "description": "ISO 8601 end timestamp.",
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "starts_at"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List the signed-in user's Chronos-V task backlog, optionally filtered by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by status, e.g. 'open' or 'done'.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Add a task to the signed-in user's Chronos-V backlog.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "estimated_min": {
              "description": "Estimated minutes (default 30).",
              "type": "integer",
              "minimum": 5,
              "maximum": 600
            },
            "priority": {
              "description": "1 (low) to 5 (high).",
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "energy": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "deadline": {
              "description": "ISO 8601 deadline timestamp.",
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "complete_task",
        "title": "Complete task",
        "description": "Mark one of the signed-in user's Chronos-V tasks as done.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Task id."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
